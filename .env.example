VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# production | development
VITE_APP_ENV=production

# Optional client log forwarding endpoint
# VITE_LOG_ENDPOINT=https://your-log-sink.example.com/ingest

# Frontend / local bot helpers (HTTPS Mini App URL — not a t.me deep link)
TELEGRAM_MINI_APP_URL=https://your-frontend.example.com
# Optional: deep link shown in the registration lock screen
# VITE_TELEGRAM_BOT_URL=https://t.me/your_bot_username
TELEGRAM_SUPPORT_CONTACT=@yegarabingo_support

# Local DEV polling bot only (`BOT_POLLING=1 npm run bot`)
# BOT_POLLING=1
# TELEGRAM_BOT_TOKEN=
# BOT_INTERNAL_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=

# Edge function secrets (set in Supabase dashboard / CLI — never VITE_):
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_WEBHOOK_SECRET=long-random-string
# TELEGRAM_MINI_APP_URL=https://your-frontend.example.com
# BOT_INTERNAL_SECRET=long-random-string
# WORKER_SECRET=your-cron-secret
# VERIFY_ET_BASE_URL=https://verify.et
# VERIFY_ET_API_KEY=VERIFY_BANK_ET_...
